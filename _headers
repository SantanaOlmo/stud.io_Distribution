# Cabeceras recomendadas (Netlify / Cloudflare Pages con soporte _headers).
# GitHub Pages IGNORA este archivo: no configura cabeceras HTTP allí.
# HTML y service worker: revalidar siempre para detectar versiones nuevas.
# Assets con hash en el nombre: caché larga (Vite ya genera hashes).

/
  X-Content-Type-Options: nosniff

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/workbox-*.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
